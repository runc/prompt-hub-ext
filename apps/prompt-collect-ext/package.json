{
  "name": "@prompt-hub/prompt-collect-ext",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv2",
    "dev:firefox": "plasmo dev --target=firefox-mv2",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "plasmo": "^0.90.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "manifest": {
    "name": "Prompt Collect",
    "description": "Collect X (Twitter) profile posts/replies with filters.",
    "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
    "permissions": ["storage", "tabs"]
  }
}

