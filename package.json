{
  "name": "prompt-hub",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "postinstall": "pnpm --filter @prompt-hub/core build",
    "dev:ext": "pnpm --filter @prompt-hub/core build && pnpm --filter @prompt-hub/extension dev",
    "dev:collect": "pnpm --filter @prompt-hub/prompt-collect-ext dev",
    "dev:web": "pnpm --filter @prompt-hub/core build && pnpm --filter @prompt-hub/web dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "build:ext": "pnpm --filter @prompt-hub/extension build",
    "build:collect": "pnpm --filter @prompt-hub/prompt-collect-ext build",
    "build:web": "pnpm --filter @prompt-hub/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
